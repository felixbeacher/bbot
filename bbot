token_instance = userdata.get("GREEN_API_TOKEN")
phone_number = userdata.get("WHATSAPP_PHONE_NUMBER")

# 1. Check if variables exist
if not all([id_instance, token_instance, phone_number]):
    print("❌ MISSING KEYS: Make sure instance ID, token, and phone number are all set in Colab Secrets.")
else:
    # Format phone number and endpoint (using media host for files)
    chat_id = f"{str(phone_number).strip('+')}@c.us"
    url = f"https://media.green-api.com/waInstance{id_instance}/sendFileByUpload/{token_instance}"

    print(f"Sending audio to {chat_id}...")

    try:
        with open("radio_briefing.mp3", "rb") as f:
            files = {'file': ('radio_briefing.mp3', f, 'audio/mpeg')}
            payload = {
                'chatId': chat_id,
                'fileName': 'radio_briefing.mp3'
            }
            res = requests.post(url, data=payload, files=files)

            print(f"Status Code: {res.status_code}")
            print(f"Server Response: {res.text}")

            # Parse the JSON response
            data = res.json()

            # Print clear, interpreted results
            print("\n--- Delivery Details ---")
            print(f"✅ Success! Your audio file was processed by the server.")
            print(f"• Message ID: {data.get('idMessage')}")
            print(f"  (Unique tracking ID generated by WhatsApp for this message)")
            print(f"• Hosted File Link: {data.get('urlFile')}")
            print(f"  (Temporary cloud link storing your MP3 on Green API servers)")

    except FileNotFoundError:
        print("❌ ERROR: radio_briefing.mp3 not found. Run Step 4 first.")
